# =================================================================
# UK Day-Ahead Renewable Wind Forecast Portal - Environment Config
# =================================================================

# Elexon BMRS API Key (Optional for basic stream endpoints; add your key from bmrs.elexon.co.uk if available)
ELEXON_API_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Allowed CORS origins (comma-separated, or * for all)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,*

# Data directory path
DATA_DIR=./data
